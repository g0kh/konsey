# PostgreSQL bağlantı dizesi
# Docker içinden: postgresql://konsey_user:konsey_pass@konsey-db:5432/onkoloji_konsey
# Yerel geliştirme (host): postgresql://konsey_user:konsey_pass@localhost:5433/onkoloji_konsey
DATABASE_URL="postgresql://konsey_user:konsey_pass@localhost:5433/onkoloji_konsey"

# Test veritabanı (.env.test dosyasında kullanılır)
# DATABASE_URL="postgresql://konsey_user:konsey_pass@localhost:5433/onkoloji_konsey_test"

# Oturum imzalama anahtarı (üretimde güçlü bir değer kullanın)
AUTH_SECRET="degistirin-guclu-bir-anahtar"

# Next.js (isteğe bağlı)
# NODE_ENV=development
